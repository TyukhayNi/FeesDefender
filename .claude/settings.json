{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-6",
  "permissions": {
    "allow": [
      "Bash(cd *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python -m scripts.*)",
      "Bash(python scripts\\*)",
      "Bash(.\\\\.venv\\\\Scripts\\\\Activate.ps1)",
      "Bash(pwsh *)",
      "Bash(powershell *)",
      "Bash(rclone copy *)",
      "Bash(rclone about *)",
      "Bash(rclone lsd *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(type *)",
      "Bash(Get-Content *)",
      "Bash(Get-ChildItem *)",
      "Bash(Select-String *)",
      "Read(*)",
      "Edit(core/**)",
      "Edit(scripts/**)",
      "Edit(tests/**)",
      "Edit(docs/**)",
      "Edit(data/_plantillas/**)",
      "Edit(STATUS.md)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)",
      "Edit(streamlit_app.py)",
      "Edit(.gitignore)",
      "Edit(requirements*.txt)",
      "Edit(pyproject.toml)",
      "Write(core/**)",
      "Write(scripts/**)",
      "Write(tests/**)",
      "Write(docs/**)",
      "Write(.claude/**)"
    ],
    "deny": [
      "Edit(data/CASOS/**)",
      "Write(data/CASOS/**)",
      "Edit(**/90_NOTAS_PERSONALES/**)",
      "Write(**/90_NOTAS_PERSONALES/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Write(.env)",
      "Write(.env.*)",
      "Bash(rm -rf *)",
      "Bash(Remove-Item -Recurse -Force *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)"
    ]
  },
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "defaultMode": "default",
  "outputStyle": "default",
  "includeCoAuthoredBy": false
}
