# Andamiaje de otras herramientas y salida de tests (producto, no fuente).
# OJO: git NO admite comentarios al final de la línea de un patrón — cada uno en su línea.
# .agents/ = espejo local de .claude/skills; la fuente única es .claude/ (ver MEJORAS #97)
.agents/
# .superpowers/ = scratch efímero de la ejecución por subagentes
.superpowers/
# .test_reports/ = JUnit XML de pytest
.test_reports/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
build/
dist/

# Node — dependencias locales de los generadores .docx de las skills
node_modules/

# Entorno
.env
.env.*
!.env.example

# Datos sensibles — NUNCA versionar expedientes
data/CASOS/*
!data/CASOS/_PLANTILLA/
!data/CASOS/_PLANTILLA/**

# Mapas de anonimización (si los usamos en algún momento)
*.anonmap
*.anonmap.json

# Intake procuradores — datasets/resultados con PII real (correos, contrarios)
scripts/intake_batch_dataset*.json
data/_aprendizaje/intake_eval_*.json
# F2 — log de auditoría de la bandeja (terna §18.9: correos, expedientes, nombres)
data/_aprendizaje/intake_audit.jsonl
# F2 — cola operativa de la bandeja (snapshots de correos en revisión)
data/_aprendizaje/intake_cola.jsonl
# Métrica derivada de aprendizaje (lleva nombre de caso real) — artefacto runtime
data/_aprendizaje/metricas.json

# Logs
logs/
*.log

# Salidas de depuración/sondeo (OCR, pytest, volcados de auditoría de correos).
# Texto volcado que arrastra PII real — el residuo de correos/OCR del 2026-07-07
# cayó justo aquí (fuera de rutas vetadas). NUNCA versionar. Ver docs/SEGURIDAD_DATOS.md.
/_*.txt
_out_*.md

# Telemetría y deltas de mejora continua de las skills — datos de expediente
# (referencias reales, texto de escritos en los deltas). Store local, NUNCA
# se versiona ni se empaqueta en el .skill (política RGPD del despacho).
data/_skill_logs/

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# Triaje 2026-07-07 — artefactos regenerables y workspace de sesión (no versionar).
# Paquetes .skill (regenerables con scripts/package_skill.py), borradores/evals
# de skills, placeholder de worktree experimental y scripts de diagnóstico one-off.
dist_skills/
_skills_drafts/
.claire/
scripts/_audit_interiores.py
scripts/_diag_gap2.py
scripts/_verify_live_it3.py
scripts/debug_search.py
scripts/debug_search2.py
scripts/test_llm_connection.py
*.swp

# Streamlit
.streamlit/secrets.toml

# Probes y sondeos locales del CRM (capturas de respuestas REST)
data/probes/

# Capturas de depuración del CRM (HAR/JSON/HTML) — contienen tokens de auth
# (bearer/PHPSESSID/x-api-key) y PII real de expedientes. NUNCA versionar.
docs/_descubrimiento/
docs/captura/
*.har
~$*.har

# Saneado de PII — mapa real→pseudónimo (local-only, reversible). NUNCA versionar.
data/_saneado/

# Allowlist real de procuradores (datos personales) — local-only. El repo solo
# versiona el .example con placeholders.
data/_config/procuradores_conocidos.yaml
# Blocklist de PII para el leak-guard (nombres/emails reales) — local-only.
data/_config/pii_blocklist.txt

# Auditorías del Drive E&V (data/_audit/*.json) — volcados con nombres,
# direcciones y refs de MUCHOS expedientes (PII transversal). Solo artefacto.
data/_audit/

# Excel lock files
~$*.xlsx
~$*.xls
~$*.xlsm

# Fixtures gold-standard de anonimización con PII real — local-only.
# El test tests/test_anon_regresion_SaRS1.py hace pytest.skip() si no
# están presentes. Política decidida en H5 del plan SaRS1 (opción a del
# Pendiente C1 de docs/superpowers/plans/PLAN_SaRS1_anon_pipeline.md §13).
tests/fixtures/anon/

# Atlas del CRM — el .json crudo (>1 MB, verdad-máquina) se regenera bajo demanda;
# solo se commitean el .md navegable y el digest. Ver spec 2026-07-20 §8.
docs/crm_atlas/atlas.json

# Claude Code — local
.claude/settings.local.json
.claude/mcp_servers.json
