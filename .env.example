# --- Rutas locales -----------------------------------------------------------
# Raíz de la base de casos. Por defecto: ./data/CASOS
CASOS_ROOT=./data/CASOS

# --- LLM local (Ollama) ------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_S=180
OLLAMA_TEMPERATURE=0.2

# --- rclone (sincronización Drive) -------------------------------------------
# Remoto tyukhay.legal (Drive personal / output anonimizado)
RCLONE_REMOTE=gdrive
RCLONE_BINARY=rclone
# Remoto engelvoelkers.com (intake carpetas W-XXXXXX de operaciones E&V)
# Configurar con: rclone config → New remote → name: gdrive_ev → type: drive
# → autenticar con nikolai.tyukhay@engelvoelkers.com
# Cada caso almacena en _caso.md: drive_ev_team_id (Shared Drive) + drive_ev_folder_id (carpeta W-XXXXXX)
# El folder_id se extrae de la URL: https://drive.google.com/drive/folders/<folder_id>
DRIVE_EV_REMOTE=gdrive_ev

# --- sudespacho.net (API CRM) ------------------------------------------------
# Obtén la API key en sudespacho.net → Ajustes → API.
# Doc oficial: https://developers.sudespacho.net/docs/category/api-crm
# OpenAPI live (PRO): https://api-crm-commons-pro.sudespacho.biz/api/docs
#
# Auth: API key como valor literal del header x-api-key (NO Authorization,
# que está reservado para JWT de sesión web). Confirmado contra el tenant
# commons-pro el 2026-04-25.
# Element por defecto: expedientes_judiciales. Para extrajudiciales:
# SUDESPACHO_ELEMENT=expedientes_extrajudiciales.
SUDESPACHO_BASE_URL=https://api-crm-commons-pro.sudespacho.biz
SUDESPACHO_API_KEY=
SUDESPACHO_AUTH_HEADER=x-api-key
SUDESPACHO_AUTH_SCHEME=
SUDESPACHO_ELEMENT=expedientes_judiciales
SUDESPACHO_TIMEOUT_S=120

# --- Frontal heredado (gestordocumental) -------------------------------------
# La API REST nueva no expone "listar documentos del expediente". Para esa
# operación el módulo usa el frontal PHP heredado del tenant, autenticado
# con la cookie PHPSESSID. Cópiala desde DevTools → Application → Cookies
# → https://<tu_subdominio>.sudespacho.net → PHPSESSID → Value.
# Caduca al cerrar sesión o por inactividad: refresca el valor cuando
# `python -m scripts.sync_sudespacho check_legacy` deje de funcionar.
SUDESPACHO_LEGACY_HOST=
SUDESPACHO_LEGACY_PHPSESSID=
SUDESPACHO_LEGACY_TIMEOUT_S=120

# --- Scoring -----------------------------------------------------------------
# heuristic | llm | hybrid
SCORING_MODE=hybrid
SCORING_TOP_K=15

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
